# Copy this file to ".env" (same folder) and fill in your values. Never upload .env anywhere:
# it is listed in .gitignore so Git skips it.
TELEGRAM_BOT_TOKEN=123456789:AA-your-bot-token
TELEGRAM_CHAT_ID=987654321

# Angel One SmartAPI (live NSE, F&O, futures, India VIX, MCX gold/silver/crude, USDINR). Leave empty for Yahoo.
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
ANGEL_TOTP_SECRET=

# Optional AI summaries (Google AI Studio): copy the exact model ID from "Get code"
GEMINI_API_KEY=
GEMINI_MODEL=

# ---- Forex live data (optional; Yahoo is the free fallback) ----
# Twelve Data free key (twelvedata.com, 800 calls/day): live EURUSD, XAU/USD, XAG/USD ...
TWELVE_DATA_API_KEY=
# MetaTrader 5 / Exness (Windows PC only). Keep the MT5 terminal open and logged in; nothing else is needed.
# Fill these only if you want the bot to log in by itself. Use an INVESTOR (read-only) password if you can.
MT5_ENABLED=1
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Exness Standard accounts add "m" to symbols (EURUSDm); the bot detects it, or set it here
MT5_SUFFIX=
# Exness server time is UTC (0). Change only if your broker's server time is different.
MT5_SERVER_UTC_OFFSET=0

# ---- Groups (optional) ----
# Easiest: add the bot to a group and send /allow there. Or list group IDs here (send /id in the group).
ALLOWED_CHATS=
# Only these Telegram user IDs may use the bot (comma separated). Empty = everyone in an allowed group.
ALLOWED_USERS=
# Extra chats (e.g. your group) that also receive automatic alerts
ALERT_CHATS=

# Where paper trades are saved. Empty = .state/store.json in this folder (Cloud Run sets gs://...)
BOT_STORE=
